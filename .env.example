# MongoDB Atlas

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/golden-pearl?retryWrites=true&w=majority



# Admin portal (orders only)

ADMIN_EMAIL=admin@goldenpearl.com

ADMIN_PASSWORD=change-me-in-production

# Optional separate JWT secret (defaults to ADMIN_PASSWORD)

# ADMIN_JWT_SECRET=



# Public site URL (Stripe redirects back here after payment)

NEXT_PUBLIC_APP_URL=http://localhost:3000



# Stripe — Pay now opens Stripe Checkout (server uses secret key)

STRIPE_SECRET_KEY=sk_live_...

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

STRIPE_WEBHOOK_SECRET=whsec_...

# Metadata on each payment in Stripe Dashboard (default: goldenpearl)
# STRIPE_SITE_ID=goldenpearl



# Local webhook forwarding (optional, keeps admin sound in sync without return URL):

# stripe listen --forward-to localhost:3000/api/webhooks/stripe


